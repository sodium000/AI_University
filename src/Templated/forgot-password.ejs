<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Password Reset OTP</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f4f7fb;
        color: #1f2937;
        padding: 40px 16px;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }

      .header {
        background-color: #2563eb;
        padding: 30px;
        text-align: center;
        color: #ffffff;
      }

      .header h1 {
        font-size: 26px;
        margin-bottom: 8px;
      }

      .header p {
        font-size: 14px;
        opacity: 0.9;
      }

      .content {
        padding: 35px 30px;
      }

      .content h2 {
        font-size: 21px;
        margin-bottom: 18px;
        color: #111827;
      }

      .content p {
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
        margin-bottom: 16px;
      }

      .otp-box {
        text-align: center;
        margin: 30px 0;
        padding: 22px;
        background-color: #eff6ff;
        border-radius: 10px;
        border: 1px solid #dbeafe;
      }

      .otp-label {
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 10px;
      }

      .otp {
        font-size: 34px;
        font-weight: bold;
        letter-spacing: 8px;
        color: #2563eb;
      }

      .expiry {
        background-color: #fff7ed;
        border-left: 4px solid #f97316;
        padding: 14px 16px;
        margin: 24px 0;
        color: #374151;
        font-size: 14px;
      }

      .security {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
      }

      .security p {
        font-size: 13px;
        color: #6b7280;
      }

      .footer {
        background-color: #f9fafb;
        padding: 22px 30px;
        text-align: center;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        font-size: 12px;
        color: #9ca3af;
        line-height: 1.6;
      }

      @media (max-width: 480px) {
        .content {
          padding: 28px 20px;
        }

        .header {
          padding: 25px 20px;
        }

        .header h1 {
          font-size: 22px;
        }

        .otp {
          font-size: 28px;
          letter-spacing: 6px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        <h1>University Management System</h1>
        <p>Password Reset</p>
      </div>

      <!-- Content -->
      <div class="content">
        <h2>Hello <%= name %>,</h2>

        <p>
          We received a request to reset the password for your University
          Management System account.
        </p>

        <p>
          Use the verification code below to continue with your password reset.
        </p>

        <!-- OTP -->
        <div class="otp-box">
          <div class="otp-label">Your verification code</div>

          <div class="otp"><%= otp %></div>
        </div>

        <!-- Expiration -->
        <div class="expiry">
          <strong>Important:</strong>
          This OTP will expire in
          <strong><%= expiresIn %></strong>.
        </div>

        <p>
          If you did not request a password reset, you can safely ignore this
          email. Your account will remain secure.
        </p>

        <!-- Security -->
        <div class="security">
          <p>
            For your security, never share this OTP with anyone. Our team will
            never ask you for your verification code.
          </p>
        </div>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          This is an automated email from the University Management System.
          Please do not reply to this email.
        </p>

        <p>
          &copy; <%= year %> University Management System. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>
```
