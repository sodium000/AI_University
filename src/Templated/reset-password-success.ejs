<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Password Changed Successfully</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f4f7fb;
        color: #1f2937;
        padding: 40px 16px;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }

      .header {
        background-color: #2563eb;
        padding: 30px;
        text-align: center;
        color: #ffffff;
      }

      .header h1 {
        font-size: 26px;
        margin-bottom: 8px;
      }

      .header p {
        font-size: 14px;
        opacity: 0.9;
      }

      .content {
        padding: 35px 30px;
      }

      .success-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background-color: #dcfce7;
        color: #16a34a;
        font-size: 34px;
        font-weight: bold;
        text-align: center;
        line-height: 64px;
      }

      .content h2 {
        text-align: center;
        font-size: 22px;
        margin-bottom: 18px;
        color: #111827;
      }

      .content p {
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
        margin-bottom: 16px;
      }

      .info-box {
        background-color: #f0fdf4;
        border-left: 4px solid #22c55e;
        padding: 16px;
        margin: 24px 0;
      }

      .info-box p {
        margin: 0;
        color: #166534;
        font-size: 14px;
      }

      .security {
        margin-top: 25px;
        padding: 20px;
        background-color: #fff7ed;
        border-radius: 8px;
      }

      .security h3 {
        font-size: 15px;
        color: #9a3412;
        margin-bottom: 10px;
      }

      .security p {
        font-size: 13px;
        color: #7c2d12;
        margin-bottom: 0;
      }

      .footer {
        background-color: #f9fafb;
        padding: 22px 30px;
        text-align: center;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        font-size: 12px;
        color: #9ca3af;
        line-height: 1.6;
        margin-bottom: 5px;
      }

      @media (max-width: 480px) {
        .content {
          padding: 28px 20px;
        }

        .header {
          padding: 25px 20px;
        }

        .header h1 {
          font-size: 22px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        <h1>University Management System</h1>
        <p>Password Security Notification</p>
      </div>

      <!-- Content -->
      <div class="content">
        <!-- Success Icon -->
        <div class="success-icon">✓</div>

        <h2>Password Changed Successfully</h2>

        <p>Hello <%= name %>,</p>

        <p>
          Your University Management System account password has been
          successfully changed.
        </p>

        <div class="info-box">
          <p>
            <strong>Your account is now secured with your new password.</strong>
          </p>
        </div>

        <p>
          You can now use your new password the next time you sign in to your
          account.
        </p>

        <!-- Security Notice -->
        <div class="security">
          <h3>Security Notice</h3>

          <p>
            If you did not make this password change, please contact the
            university administration immediately and secure your account.
          </p>
        </div>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          This is an automated email from the University Management System.
          Please do not reply to this email.
        </p>

        <p>
          &copy; <%= year %> University Management System. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>
```
